opam-version: "2.0"
synopsis: "Typed content generator for Ryujin Hatakeyama's website"
description: "Validates structured update records and exports public JSON for the Rust site builder."
maintainer: "Ryujin Hatakeyama"
authors: "Ryujin Hatakeyama"
license: "UNLICENSED"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]

