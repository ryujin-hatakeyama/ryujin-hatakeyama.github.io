---
import { getCollection, render } from 'astro:content';
import WritingLayout from '../../layouts/WritingLayout.astro';

export async function getStaticPaths() {
  const writings = await getCollection('writings', ({ data }) => !data.draft && data.lang === 'en');
  return writings.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<WritingLayout entry={entry}>
  <Content />
</WritingLayout>
