---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Page not found" description="The requested page could not be found." currentPath="/404/" noindex>
  <section class="detail-sheet">
    <p class="longform-kicker">404 / Not found</p>
    <h1>Nothing is filed here.</h1>
    <p class="summary">The address may have changed, or the page may not be public.</p>
    <p><a href={withBase('/')}>Return home</a> <span aria-hidden="true">·</span> <a href={withBase('/research/')}>Browse research</a></p>
  </section>
</BaseLayout>

