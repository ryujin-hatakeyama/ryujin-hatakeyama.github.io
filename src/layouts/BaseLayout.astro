---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  locale?: 'en' | 'ja';
  currentPath: string;
  alternatePath?: string;
  alternateIsExact?: boolean;
  noindex?: boolean;
  article?: boolean;
}

const {
  title, description, locale = 'en', currentPath,
  noindex = false, article = false
} = Astro.props;
const fullTitle = title === 'Ryujin Hatakeyama' ? title : `${title} — Ryujin Hatakeyama`;
const canonical = Astro.site ? new URL(withBase(currentPath), Astro.site) : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111820" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Ryujin Hatakeyama — Updates" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <title>{fullTitle}</title>
    <script is:inline>
      (() => {
        let choice = null;
        try {
          const stored = localStorage.getItem('appearance');
          choice = stored === 'light' || stored === 'dark' ? stored : null;
        } catch {}
        const dark = choice === 'dark' || (choice === null && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.appearance = choice ?? 'system';
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'ja' ? '本文へ移動' : 'Skip to content'}</a>
    <div class="site-shell">
      <Header currentPath={currentPath} />
      <main id="main-content"><slot /></main>
      <Footer />
    </div>
  </body>
</html>
