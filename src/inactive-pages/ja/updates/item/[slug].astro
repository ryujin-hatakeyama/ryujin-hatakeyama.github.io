---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { categoryLabels, formatDate, kindLabels } from '../../../../lib/content';

export async function getStaticPaths() {
  const updates = await getCollection('updates', ({ data }) => data.detail);
  return updates.map((entry) => ({ params: { slug: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props;
const title = entry.data.title.ja ?? entry.data.title.en;
const summary = entry.data.summary.ja ?? entry.data.summary.en;
---

<BaseLayout title={title} description={summary} locale="ja" currentPath={`/ja/updates/item/${entry.data.id}/`} alternatePath={`/updates/item/${entry.data.id}/`} article>
  <article class="detail-sheet">
    <header>
      <p class="longform-kicker">更新 <span aria-hidden="true">/</span> {kindLabels.ja[entry.data.kind.type]}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </header>
    <dl>
      <div class="detail-meta"><dt>出来事の日付</dt><dd><time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date, 'ja')}</time></dd></div>
      <div class="detail-meta"><dt>掲載日</dt><dd><time datetime={entry.data.announcedOn.toISOString().slice(0, 10)}>{formatDate(entry.data.announcedOn, 'ja')}</time></dd></div>
      <div class="detail-meta"><dt>カテゴリー</dt><dd>{entry.data.categories.map((category: keyof typeof categoryLabels.ja) => categoryLabels.ja[category]).join(' · ')}</dd></div>
    </dl>
    {(entry.data.body?.ja ?? entry.data.body?.en) && <div class="prose"><p>{entry.data.body?.ja ?? entry.data.body?.en}</p></div>}
    {entry.data.links.length > 0 && <p class="record-links">{entry.data.links.map((link: any) => <a href={link.url}>{link.label}</a>)}</p>}
  </article>
</BaseLayout>

