---
import AppearanceControl from './AppearanceControl.astro';
import { withBase } from '../lib/paths';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  { href: '/updates/', label: 'Updates' }
];
const isActive = (href: string) => {
  if (href === '/') return currentPath === href;
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <a class="wordmark" href={withBase('/')} aria-label="Ryujin Hatakeyama home">
    Ryujin Hatakeyama
  </a>
  <nav class="primary-nav" aria-label="Primary navigation">
    {nav.map((item) => (
      <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="header-tools">
    <AppearanceControl />
  </div>
</header>
