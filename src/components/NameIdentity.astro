---
import { siteInfo } from '../data/site';
const { headingId = 'home-name' } = Astro.props;
---

<div class="identity-block">
  <h1 id={headingId}>{siteInfo.name}</h1>
  {siteInfo.nameJapanese && <p class="name-japanese" lang="ja">{siteInfo.nameJapanese}</p>}
  {siteInfo.pronunciation && (
    <p class="name-pronunciation">
      <span lang="ja">{siteInfo.pronunciation.reading}</span>
      {siteInfo.pronunciation.ipa && <><span aria-hidden="true"> · </span><span class="ipa">/{siteInfo.pronunciation.ipa}/</span></>}
    </p>
  )}
</div>
