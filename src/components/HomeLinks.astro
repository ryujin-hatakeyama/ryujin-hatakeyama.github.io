---
import { siteInfo } from '../data/site';
import { withBase } from '../lib/paths';

const suppliedLinks = [...siteInfo.academicLinks, ...siteInfo.contacts];
const isGitHub = (link: { label: string; href: string }) =>
  link.label.toLowerCase() === 'github' || /^https?:\/\/(?:www\.)?github\.com\//i.test(link.href);
const isEmail = (link: { label: string; href: string }) =>
  link.label.toLowerCase() === 'email' || link.href.startsWith('mailto:');
const github = suppliedLinks.find(isGitHub);
const email = suppliedLinks.find(isEmail);
---

<nav class="home-links" aria-label="Academic and contact links">
  <ul class="home-academic-links">
    {siteInfo.cv && (
      <li>
        <a href={withBase(siteInfo.cv.href)}>
          <svg class="home-link-icon" aria-hidden="true" viewBox="0 0 16 16">
            <path d="M3.5 1.5h6l3 3v10h-9zM9.5 1.5v3h3M5.5 7.5h5M5.5 10h5M5.5 12.5h3.5" />
          </svg>
          <span>{siteInfo.cv.label ?? 'CV'}</span>
        </a>
      </li>
    )}
    <li><a href={withBase('/research/#presentations')}>Talks & Presentations</a></li>
    {github && (
      <li>
        <a href={github.href}>
          <svg class="home-link-icon" aria-hidden="true" viewBox="0 0 16 16">
            <path d="M8 1.3a6.7 6.7 0 0 0-2.1 13.1c.3.1.4-.1.4-.3v-1.3c-1.8.4-2.2-.8-2.2-.8-.3-.8-.7-1-1-1.2-.6-.4 0-.4 0-.4.7.1 1.1.7 1.1.7.6 1.1 1.7.8 2.1.6.1-.5.2-.8.5-1-1.5-.2-3-.7-3-3.3 0-.7.3-1.3.7-1.8-.1-.2-.3-.8.1-1.8 0 0 .6-.2 1.8.7A6.4 6.4 0 0 1 8 4.3c.6 0 1.1.1 1.6.2 1.3-.9 1.8-.7 1.8-.7.4 1 .2 1.6.1 1.8.5.5.7 1.1.7 1.8 0 2.6-1.6 3.1-3 3.3.3.2.5.6.5 1.2v2.2c0 .2.1.4.5.3A6.7 6.7 0 0 0 8 1.3Z" fill="currentColor" stroke="none" />
          </svg>
          <span>GitHub</span>
        </a>
      </li>
    )}
    {email && (
      <li>
        <a href={email.href}>
          <svg class="home-link-icon" aria-hidden="true" viewBox="0 0 16 16">
            <path d="M1.5 3.5h13v9h-13zM2 4l6 4.5L14 4" />
          </svg>
          <span>Email</span>
        </a>
      </li>
    )}
  </ul>
</nav>
