---
import { categoryLabels } from '../lib/content';
import { withBase } from '../lib/paths';
const { locale = 'en', active = 'all' } = Astro.props;
const root = locale === 'ja' ? '/ja/updates/' : '/updates/';
const labels = categoryLabels[locale as 'en' | 'ja'];
const items = [
  { key: 'all', label: locale === 'ja' ? 'すべて' : 'All', href: root },
  ...Object.entries(labels).map(([key, label]) => ({ key, label, href: `${root}${key}/` }))
];
---

<nav class="update-filters" aria-label={locale === 'ja' ? '更新カテゴリー' : 'Update categories'}>
  {items.map((item) => (
    <a href={withBase(item.href)} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>

